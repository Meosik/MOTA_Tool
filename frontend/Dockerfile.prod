# Multi-stage production build (smaller than dev server image)
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev
COPY . .
# API base baked at build time; override by editing .env or vite config before build
RUN npm run build

FROM nginx:1.27-alpine
# Copy build output
COPY --from=build /app/dist /usr/share/nginx/html
# Default nginx serves on 80
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
